rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only the authenticated owner can read/write their own data
    match /users/{userId}/{document=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().size() <= 30
        && (!('title' in request.resource.data) || (request.resource.data.title is string && request.resource.data.title.size() <= 500))
        && (!('author' in request.resource.data) || (request.resource.data.author is string && request.resource.data.author.size() <= 500))
        && (!('cover_url' in request.resource.data) || (request.resource.data.cover_url is string && request.resource.data.cover_url.size() <= 2000))
        && (!('notes' in request.resource.data) || (request.resource.data.notes is string && request.resource.data.notes.size() <= 10000))
        && (!('total_pages' in request.resource.data) || request.resource.data.total_pages is number)
        && (!('pages_read' in request.resource.data) || request.resource.data.pages_read is number)
        && (!('current_page' in request.resource.data) || request.resource.data.current_page is number)
        && (!('read_count' in request.resource.data) || request.resource.data.read_count is number)
        && (!('minutes_spent' in request.resource.data) || request.resource.data.minutes_spent is number || request.resource.data.minutes_spent == null)
        && (!('status' in request.resource.data) || (request.resource.data.status is string && request.resource.data.status.size() <= 50));
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
